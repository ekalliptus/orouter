DATA_DIR=/var/lib/9router
STATIC_DIR=/opt/orouter/current/web
RUST_HOST=127.0.0.1
RUST_PORT=20130
RUST_LOG_LEVEL=info
RUST_BODY_MAX_MB=128
RUST_SHUTDOWN_TIMEOUT=15s

JWT_SECRET=replace-with-64-hex-characters
INITIAL_PASSWORD=replace-with-a-strong-password
API_KEY_SECRET=replace-with-64-hex-characters
AUTH_COOKIE_SECURE=true
