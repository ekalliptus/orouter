[Unit]
Description=ORouter - AI Infrastructure Management (9Router)
After=network.target

[Service]
Type=simple
User=ubuntu
# NOTE: User must match the target box's SSH user. GCP box was "ekalliptus"
# (metadata-managed key); the current elsaver box uses "ubuntu". If the
# service fails with 217/USER ("Unknown user"), fix this line, then
# `sudo systemctl daemon-reload && sudo systemctl restart orouter`.
WorkingDirectory=/opt/orouter
Environment=PORT=20128
Environment=HOSTNAME=0.0.0.0
Environment=NEXT_PRIVATE_STANDALONE_CONFIG=1
ExecStart=/usr/bin/node custom-server.js --port 20128
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
